{
  "name": "nous-builder-agent",
  "version": "0.3.0",
  "description": "Autonomous builder agent for NOUS Protocol — monitors, analyses, benchmarks, and develops the launchpad continuously",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start":     "node index.js",
    "audit":     "NOUS_API_URL=${NOUS_API_URL:-http://localhost:3000} node -e \"import('./tasks/audit-endpoints.js').then(m=>m.auditEndpoints({log:console.log,API_URL:process.env.NOUS_API_URL}))\"",
    "benchmark": "NOUS_API_URL=${NOUS_API_URL:-http://localhost:3000} node -e \"import('./tasks/benchmark-api.js').then(m=>m.benchmarkApi({log:console.log,API_URL:process.env.NOUS_API_URL}))\""
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
